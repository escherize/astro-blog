---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "About Escherize";
const identity = {
  firstName: "Bryan",
  lastName: "Maass",
  country: "USA",
  occupation: "Software Engineer",
  hobbies: ["strength training", "geometry", "gleam lang", "fantasy consoles"],
};
---

<BaseLayout
  title={pageTitle}
  description="Software engineer passionate about functional programming, developer tooling, and building practical solutions."
  ogType="profile"
>
  <style>
    /* ============================================
       ABOUT PAGE - Playful Chaos Edition
       ============================================ */

    .page {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-8) var(--space-6);
    }

    /* ============================================
       HERO SECTION - Big, Bold, Memorable
       ============================================ */
    .hero {
      position: relative;
      padding: var(--space-16) 0 var(--space-12);
      border-bottom: 3px solid var(--color-fg);
      margin-bottom: var(--space-12);
      overflow: visible;
    }

    .hero-content {
      position: relative;
      z-index: 1;
    }

    /* Decorative shapes */
    .hero::before {
      content: '';
      position: absolute;
      top: var(--space-8);
      right: 0;
      width: 200px;
      height: 200px;
      background: var(--color-accent-soft);
      border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
      opacity: 0.6;
      pointer-events: none;
      animation: blobFloat 8s ease-in-out infinite;
    }

    .hero::after {
      content: '';
      position: absolute;
      bottom: var(--space-12);
      right: 15%;
      width: 80px;
      height: 80px;
      background: var(--color-pop-soft);
      border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
      opacity: 0.5;
      pointer-events: none;
      animation: blobFloat 6s ease-in-out infinite reverse;
    }

    @keyframes blobFloat {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      50% { transform: translate(-10px, 10px) rotate(5deg); }
    }

    .hero-label {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      font-family: var(--font-display);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-fg-muted);
      margin-bottom: var(--space-4);
      animation: slideDown 0.5s var(--ease-out-expo) backwards;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
    }

    .hero-label::before {
      content: '';
      width: 40px;
      height: 3px;
      background: var(--color-accent);
    }

    .hero-name {
      font-size: clamp(3rem, 10vw, 6rem);
      font-weight: var(--font-weight-bold);
      line-height: 0.95;
      letter-spacing: -0.04em;
      margin: 0 0 var(--space-6);
      animation: heroSlide 0.6s var(--ease-out-expo) 0.1s backwards;
    }

    @keyframes heroSlide {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
    }

    .hero-name-first {
      display: block;
      color: var(--color-fg);
    }

    .hero-name-last {
      display: block;
      color: var(--color-accent);
      font-style: italic;
    }

    .hero-tagline {
      font-size: var(--font-size-xl);
      color: var(--color-fg-muted);
      max-width: 500px;
      line-height: var(--line-height-normal);
      margin: 0 0 var(--space-8);
      animation: heroSlide 0.6s var(--ease-out-expo) 0.2s backwards;
    }

    .hero-tagline strong {
      color: var(--color-fg);
      font-weight: var(--font-weight-semibold);
    }

    /* Status badge - Playful */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      font-family: var(--font-display);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      padding: var(--space-2) var(--space-4);
      background: var(--color-bg-elevated);
      border: 2px solid var(--color-fg);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-offset-sm);
      animation: heroSlide 0.6s var(--ease-out-expo) 0.3s backwards;
      transition: all var(--transition-fast);
    }

    .status-badge:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--shadow-offset-md);
    }

    .status-dot {
      width: var(--icon-sm);
      height: var(--icon-sm);
      background: var(--color-success);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.7; transform: scale(1.1); }
    }

    /* ============================================
       QUICK FACTS - Bold Stats Row
       ============================================ */
    .facts {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    @media (max-width: 640px) {
      .facts {
        grid-template-columns: 1fr;
        gap: var(--space-3);
      }
    }

    .fact {
      padding: var(--space-5);
      background: var(--color-bg-elevated);
      border: 2px solid var(--color-fg);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-offset-sm);
      transition: all var(--transition-fast);
      animation: factSlide 0.5s var(--ease-out-expo) backwards;
    }

    .fact:nth-child(1) { animation-delay: 0.1s; }
    .fact:nth-child(2) { animation-delay: 0.15s; }
    .fact:nth-child(3) { animation-delay: 0.2s; }

    @keyframes factSlide {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }

    .fact:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--shadow-offset-md);
    }

    .fact-label {
      font-family: var(--font-display);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-fg-muted);
      margin-bottom: var(--space-2);
    }

    .fact-value {
      font-family: var(--font-display);
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-bold);
      color: var(--color-fg);
    }

    .fact:nth-child(2) .fact-value {
      color: var(--color-accent);
    }

    /* ============================================
       INTRO SECTION - Big Statement
       ============================================ */
    .intro-section {
      margin-bottom: var(--space-12);
      animation: fadeIn 0.5s var(--ease-out-expo) 0.3s backwards;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
    }

    .section-label {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-family: var(--font-display);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-fg-muted);
      margin-bottom: var(--space-5);
    }

    .section-label::after {
      content: '';
      flex: 1;
      height: 2px;
      background: var(--color-border);
    }

    .intro-text {
      font-size: var(--font-size-xl);
      line-height: var(--line-height-relaxed);
      color: var(--color-fg);
      padding: var(--space-8);
      background: var(--color-bg-elevated);
      border: 3px solid var(--color-fg);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-offset-lg);
      position: relative;
    }

    .intro-text::before {
      content: '"';
      position: absolute;
      top: var(--space-3);
      left: var(--space-4);
      font-size: 4rem;
      font-family: var(--font-display);
      color: var(--color-accent);
      opacity: 0.2;
      line-height: 1;
    }

    .intro-text strong {
      color: var(--color-accent);
      font-weight: var(--font-weight-bold);
    }

    .intro-text em {
      color: var(--color-pop);
      font-style: normal;
      background: var(--color-pop-soft);
      padding: 0 var(--space-1);
      border-radius: var(--radius-sm);
    }

    /* ============================================
       CONTENT PANELS - Bold Cards
       ============================================ */
    .panels-section {
      margin-bottom: var(--space-12);
    }

    .panels-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }

    @media (max-width: 700px) {
      .panels-grid {
        grid-template-columns: 1fr;
      }
    }

    .panel {
      padding: var(--space-6);
      background: var(--color-bg-elevated);
      border: 2px solid var(--color-fg);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-offset-sm);
      transition: all var(--transition-fast);
      animation: panelSlide 0.5s var(--ease-out-expo) backwards;
    }

    .panel:nth-child(1) { animation-delay: 0.35s; }
    .panel:nth-child(2) { animation-delay: 0.4s; }
    .panel:nth-child(3) { animation-delay: 0.45s; }
    .panel:nth-child(4) { animation-delay: 0.5s; }

    @keyframes panelSlide {
      from {
        opacity: 0;
        transform: translateY(20px) rotate(-1deg);
      }
    }

    .panel:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--shadow-offset-md);
    }

    .panel-header {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
    }

    .panel-icon {
      width: var(--icon-lg);
      height: var(--icon-lg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--font-size-lg);
      background: var(--color-accent);
      color: white;
      border-radius: var(--radius-sm);
      flex-shrink: 0;
    }

    .panel:nth-child(2) .panel-icon { background: var(--color-pop); }
    .panel:nth-child(3) .panel-icon { background: var(--color-fg); }
    .panel:nth-child(4) .panel-icon { background: var(--color-success); }

    .panel h2 {
      font-family: var(--font-display);
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-bold);
      color: var(--color-fg);
      margin: 0;
    }

    .panel p {
      font-size: var(--font-size-base);
      color: var(--color-fg-muted);
      line-height: var(--line-height-normal);
      margin: 0 0 var(--space-4);
    }

    .panel ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .panel li {
      position: relative;
      padding-left: var(--space-5);
      margin-bottom: var(--space-2);
      font-size: var(--font-size-sm);
      color: var(--color-fg);
    }

    .panel li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: var(--font-weight-bold);
    }

    .panel:nth-child(2) li::before { color: var(--color-pop); }
    .panel:nth-child(3) li::before { color: var(--color-fg); }
    .panel:nth-child(4) li::before { color: var(--color-success); }

    .panel a {
      color: var(--color-accent);
      text-decoration: none;
      font-weight: var(--font-weight-medium);
      border-bottom: 2px solid var(--color-accent-soft);
      transition: all var(--transition-fast);
    }

    .panel a:hover {
      background: var(--color-accent-soft);
      border-bottom-color: var(--color-accent);
    }

    /* Skills/Pills */
    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
    }

    .skill {
      font-family: var(--font-display);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-medium);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: var(--space-1) var(--space-3);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      color: var(--color-fg-muted);
      transition: all var(--transition-fast);
    }

    .skill:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      transform: translateY(-2px);
    }

    /* ============================================
       CONTACT SECTION - Bold CTA
       ============================================ */
    .contact-section {
      text-align: center;
      padding: var(--space-12) var(--space-8);
      background: var(--color-fg);
      color: var(--color-bg);
      border-radius: var(--radius-lg);
      position: relative;
      overflow: hidden;
      animation: contactSlide 0.5s var(--ease-out-expo) 0.55s backwards;
    }

    @keyframes contactSlide {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
    }

    .contact-section::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 300px;
      height: 300px;
      background: var(--color-accent);
      border-radius: 50%;
      opacity: 0.1;
      pointer-events: none;
    }

    .contact-heading {
      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-bold);
      margin: 0 0 var(--space-4);
      position: relative;
    }

    .contact-text {
      font-size: var(--font-size-lg);
      opacity: 0.8;
      max-width: 500px;
      margin: 0 auto var(--space-8);
      line-height: var(--line-height-normal);
      position: relative;
    }

    .contact-links {
      display: flex;
      justify-content: center;
      gap: var(--space-4);
      flex-wrap: wrap;
      position: relative;
    }

    .contact-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-family: var(--font-display);
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-bold);
      padding: var(--space-3) var(--space-6);
      background: var(--color-bg);
      color: var(--color-fg);
      border: 2px solid var(--color-bg);
      border-radius: var(--radius-md);
      text-decoration: none;
      transition: all var(--transition-fast);
    }

    .contact-link:hover {
      background: transparent;
      color: var(--color-bg);
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }

    .contact-link.primary {
      background: var(--color-accent);
      color: white;
      border-color: var(--color-accent);
    }

    .contact-link.primary:hover {
      background: var(--color-accent-hover);
      border-color: var(--color-accent-hover);
      color: white;
    }

    /* ============================================
       RESPONSIVE
       ============================================ */
    @media (max-width: 640px) {
      .page {
        padding: var(--space-6) var(--space-4);
      }

      .hero {
        padding: var(--space-10) 0 var(--space-8);
      }

      .hero::before,
      .hero::after {
        display: none;
      }

      .hero-name {
        font-size: clamp(2.5rem, 12vw, 4rem);
      }

      .hero-tagline {
        font-size: var(--font-size-lg);
      }

      .intro-text {
        padding: var(--space-6);
        font-size: var(--font-size-lg);
        box-shadow: var(--shadow-offset-md);
      }

      .contact-section {
        padding: var(--space-8) var(--space-5);
      }

      .contact-links {
        flex-direction: column;
      }

      .contact-link {
        width: 100%;
        justify-content: center;
      }
    }

    /* ============================================
       REDUCED MOTION
       ============================================ */
    @media (prefers-reduced-motion: reduce) {
      .hero::before,
      .hero::after,
      .status-dot {
        animation: none;
      }
    }
  </style>

  <main id="main-content" class="page">
    <!-- Hero Section -->
    <section class="hero" aria-label="Introduction">
      <div class="hero-content">
        <div class="hero-label">About</div>
        <h1 class="hero-name">
          <span class="hero-name-first">{identity.firstName}</span>
          <span class="hero-name-last">{identity.lastName}</span>
        </h1>
        <p class="hero-tagline">
          <strong>Software engineer</strong> who gets unreasonably excited about developer tooling, functional programming, and making software that sparks joy.
        </p>
        <div class="status-badge">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Happily employed & always curious</span>
        </div>
      </div>
    </section>

    <!-- Quick Facts -->
    <section class="facts" aria-label="Quick facts">
      <div class="fact">
        <div class="fact-label">Location</div>
        <div class="fact-value">Boise, Idaho</div>
      </div>
      <div class="fact">
        <div class="fact-label">Current Role</div>
        <div class="fact-value">Software Engineer</div>
      </div>
      <div class="fact">
        <div class="fact-label">Focus</div>
        <div class="fact-value">Backend & Tooling</div>
      </div>
    </section>

    <!-- Intro Statement -->
    <section class="intro-section" aria-label="Introduction">
      <div class="section-label">The Short Version</div>
      <div class="intro-text">
        <p>
          I'm a <strong>software engineer</strong> with deep functional programming experience who enjoys designing clear systems, improving developer experience, and turning complex problems into practical solutions. I care about maintainable code, <em>building the right thing</em>, thoughtful APIs, and tools that make others more effective.
        </p>
      </div>
    </section>

    <!-- Content Panels -->
    <section class="panels-section" aria-label="Details">
      <div class="section-label">More Details</div>
      <div class="panels-grid">
        <div class="panel">
          <div class="panel-header">
            <div class="panel-icon" aria-hidden="true">⚙</div>
            <h2>What I Build</h2>
          </div>
          <p>
            Backend services, APIs, and developer tools. I like owning problems end-to-end—from design through maintenance.
          </p>
          <ul>
            <li>Designing and implementing backend services</li>
            <li>Improving performance & observability</li>
            <li>Building internal tooling & workflows</li>
          </ul>
          <div class="skills">
            <span class="skill">Distributed systems</span>
            <span class="skill">Databases</span>
            <span class="skill">Testing & CI</span>
          </div>
        </div>

        <div class="panel">
          <div class="panel-header">
            <div class="panel-icon" aria-hidden="true">🧠</div>
            <h2>How I Think</h2>
          </div>
          <p>
            Clear interfaces, boring tech used well, tight feedback loops. Document decisions, reason about trade-offs.
          </p>
          <ul>
            <li>Small, composable building blocks</li>
            <li>Measure before optimizing</li>
            <li>Write things down for future you</li>
          </ul>
        </div>

        <div class="panel">
          <div class="panel-header">
            <div class="panel-icon" aria-hidden="true">🔬</div>
            <h2>Side Projects</h2>
          </div>
          <p>
            Experiments, tools, and questionable ideas that shouldn't work but somehow do.
          </p>
          <ul>
            <li><strong>go-silo</strong> — Markdown for file structures</li>
            <li><strong><a href="https://x.com/escherize/status/1948930729477644695">goto in Clojure</a></strong> — It's not harmful, right?</li>
            <li><strong>Glick80</strong> — Gleam on fantasy consoles</li>
          </ul>
          <div class="skills">
            <span class="skill">Functional programming</span>
            <span class="skill">Open source</span>
            <span class="skill">Experiments</span>
          </div>
        </div>

        <div class="panel">
          <div class="panel-header">
            <div class="panel-icon" aria-hidden="true">🌱</div>
            <h2>Outside Code</h2>
          </div>
          <p>
            Away from the editor—family, learning, and skills completely unrelated to software.
          </p>
          <ul>
            <li>Time with family and close friends</li>
            <li>Teaching my kids about math</li>
            <li>Reading about geometry & systems</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="contact-section" aria-label="Contact">
      <h2 class="contact-heading">Let's Connect</h2>
      <p class="contact-text">
        Want to collaborate, discuss an idea, or just say hello? I'm always happy to chat.
      </p>
      <div class="contact-links">
        <a href="mailto:bryan.maass@gmail.com" class="contact-link primary">
          Email Me
        </a>
        <a href="https://github.com/escherize" class="contact-link" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
        <a href="https://x.com/escherize" class="contact-link" target="_blank" rel="noopener noreferrer">
          Twitter
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
