---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  {
    title: "Bringing SQLGlot to Metabase: Swappable SQL Parsing via GraalVM",
    url: "/posts/post-5/",
    description: "How we integrated SQLGlot into Metabase's JVM codebase using GraalVM, enabling swappable SQL parsing implementations.",
    pubDate: "2024-12-15",
    tags: ["metabase", "graalvm", "tools"]
  },
  {
    title: "Goto in Clojure: Why I Built It and Why It's Fun",
    url: "/posts/post-1/",
    description: "A deep dive into my experimental goto macro for Clojure—how it works, why it's cool, and why Dijkstra might still yell at me.",
    pubDate: "2024-11-24",
    tags: ["clojure", "macros", "experimental"]
  },
  {
    title: "Introducing go-silo: Markdown for File Structures",
    url: "/posts/post-2/",
    description: "Why I built go-silo, how it works, and how it treats file-structure-+-content as Markdown-first.",
    pubDate: "2024-11-24",
    tags: ["go", "tools", "markdown"]
  },
  {
    title: "Mage at Metabase: A Unified Task Runner",
    url: "/posts/post-3/",
    description: "How we built a shell-script wrapper around Babashka tasks (Mage) to streamline dev workflows at Metabase.",
    pubDate: "2024-11-24",
    tags: ["metabase", "tooling", "dx"]
  },
  {
    title: "Glick80: Functional Purity Meets Retro Gaming",
    url: "/posts/post-4/",
    description: "I brought Gleam's type-safe functional programming to the TIC-80 fantasy console. Pure functions, 8-bit graphics, and zero mutations.",
    pubDate: "2024-11-28",
    tags: ["gleam", "games", "functional"]
  }
];

const pageTitle = "Blog - Escherize Zone";
const description = "Technical posts about functional programming, developer tooling, and creative coding experiments.";
---

<BaseLayout
  title={pageTitle}
  description={description}
>
  <main id="main-content" class="page">
    <header class="page-header">
      <h1 class="page-title">All Posts</h1>
      <p class="page-subtitle">
        Functional programming, developer tooling, and creative experiments.
      </p>
    </header>

    <div class="posts-list">
      {posts.map((post, index) => (
        <article class="post-card" style={`--delay: ${index * 75}ms`}>
          <a href={post.url} class="post-link">
            <div class="post-content">
              <div class="post-header">
                <time class="post-date" datetime={post.pubDate}>
                  {new Date(post.pubDate).toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                  })}
                </time>
                <div class="post-tags">
                  {post.tags.slice(0, 2).map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
              <h2 class="post-title">{post.title}</h2>
              <p class="post-description">{post.description}</p>
            </div>
            <span class="post-arrow">→</span>
          </a>
        </article>
      ))}
    </div>

    <footer class="page-footer">
      <a href="/" class="back-link">← Back to home</a>
    </footer>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }

  /* ============================================
     PAGE HEADER
     ============================================ */
  .page-header {
    padding: var(--space-12) 0;
    border-bottom: 2px solid var(--color-fg);
    margin-bottom: var(--space-10);
  }

  .page-title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.03em;
  }

  .page-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-fg-muted);
    margin: 0;
    max-width: 500px;
  }

  /* ============================================
     POSTS LIST
     ============================================ */
  .posts-list {
    display: grid;
    gap: var(--space-4);
  }

  .post-card {
    animation: slideIn 0.5s var(--ease-out-expo) backwards;
    animation-delay: var(--delay);
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .post-link {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .post-link:hover {
    border-color: var(--color-fg);
    transform: translateX(8px);
    box-shadow: var(--shadow-playful);
  }

  .post-content {
    flex: 1;
    min-width: 0;
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .post-date {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    color: var(--color-fg-subtle);
  }

  .post-tags {
    display: flex;
    gap: var(--space-2);
  }

  .tag {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-bg);
    background: var(--color-accent);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .tag:nth-child(2) {
    background: var(--color-pop);
  }

  .post-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--space-2);
    color: var(--color-fg);
    line-height: var(--line-height-tight);
  }

  .post-description {
    font-size: var(--font-size-base);
    color: var(--color-fg-muted);
    margin: 0;
    line-height: var(--line-height-normal);
  }

  .post-arrow {
    font-size: var(--font-size-2xl);
    color: var(--color-fg-subtle);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .post-link:hover .post-arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  /* ============================================
     PAGE FOOTER
     ============================================ */
  .page-footer {
    padding-top: var(--space-12);
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-family: var(--font-display);
    font-weight: var(--font-weight-medium);
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 640px) {
    .page {
      padding: var(--space-6) var(--space-4);
    }

    .page-header {
      padding: var(--space-8) 0;
    }

    .page-title {
      font-size: var(--font-size-3xl);
    }

    .post-link {
      padding: var(--space-4);
      gap: var(--space-4);
    }

    .post-header {
      flex-wrap: wrap;
    }

    .post-title {
      font-size: var(--font-size-lg);
    }

    .post-description {
      font-size: var(--font-size-sm);
    }

    .post-arrow {
      display: none;
    }
  }
</style>
