---
/**
 * PenroseASCII - Floating ASCII Penrose triangle background decoration
 */
---

<div class="penrose-bg" aria-hidden="true">
  <pre class="penrose-ascii"></pre>
</div>

<style>
  .penrose-bg {
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    opacity: 0.5;
    pointer-events: none;
    z-index: -1;
  }

  .penrose-ascii {
    font-family: var(--font-mono);
    font-size: clamp(8px, 1.4vw, 16px);
    line-height: 1.0;
    letter-spacing: 0;
    margin: 0;
    padding: 0;
    white-space: pre;
    background: transparent;
  }

  .penrose-ascii :global(.c0) { color: var(--color-accent); }
  .penrose-ascii :global(.c1) { color: var(--color-pop); }
  .penrose-ascii :global(.c2) { color: var(--color-fg-muted); }

  @media (max-width: 768px) {
    .penrose-bg {
      display: none;
    }
  }
</style>

<script>
  class PenroseRenderer {
    constructor(container) {
      this.pre = container.querySelector('.penrose-ascii');
      this.rotation = 0; // Static angle
      this.canvas = document.createElement('canvas');
      this.ctx = this.canvas.getContext('2d');

      // Fixed size for background decoration
      this.cols = 70;
      this.rows = 50;
      this.cellWidth = 8;
      this.cellHeight = 12;
      this.canvas.width = this.cols * this.cellWidth;
      this.canvas.height = this.rows * this.cellHeight;

      this.animate();
    }

    animate() {
      // Magic Penrose angle
      const magicX = 0.670;
      const magicY = 0.660;

      // Scroll-based rotation
      const scrollRange = 800; // pixels of scroll for full range
      const maxOffset = 0.3; // rotation range

      const updateFromScroll = () => {
        const scrollY = window.scrollY;
        const t = Math.min(scrollY / scrollRange, 1); // 0 to 1

        // Custom ease: fast at edges, slow/flat in middle (plateau at magic angle)
        // Using smoothstep-like curve that spends more time near 0.5
        let ease;
        if (t < 0.33) {
          // First third: ease quickly toward magic angle
          const localT = t / 0.33; // 0 to 1
          ease = -1 + localT * localT * localT; // cubic ease-in, -1 to 0
        } else if (t < 0.66) {
          // Middle third: stay near magic angle (plateau)
          ease = 0; // flat at magic angle
        } else {
          // Last third: ease away from magic angle
          const localT = (t - 0.66) / 0.34; // 0 to 1
          ease = localT * localT * localT; // cubic ease-in, 0 to 1
        }

        const offset = ease * maxOffset;
        this.currentRX = magicX + offset * 0.5;
        this.currentRY = magicY + offset;
        this.render();
      };

      window.addEventListener('scroll', updateFromScroll, { passive: true });
      updateFromScroll(); // Initial render
    }

    rotateY(p, angle) {
      const cos = Math.cos(angle);
      const sin = Math.sin(angle);
      return { x: p.x * cos - p.z * sin, y: p.y, z: p.x * sin + p.z * cos };
    }

    rotateX(p, angle) {
      const cos = Math.cos(angle);
      const sin = Math.sin(angle);
      return { x: p.x, y: p.y * cos - p.z * sin, z: p.y * sin + p.z * cos };
    }

    project(point) {
      // Use scroll-adjusted rotation (defaults to magic angle)
      const rx = this.currentRX ?? 0.670;
      const ry = this.currentRY ?? 0.660;
      let p = this.rotateY(point, ry);
      p = this.rotateX(p, rx);
      return p;
    }

    createBar(cx, cy, cz, axis, length, thick) {
      const hl = length / 2, ht = thick / 2;
      let dims;
      if (axis === 'x') dims = [length, thick, thick];
      else if (axis === 'y') dims = [thick, length, thick];
      else dims = [thick, thick, length];

      const [w, h, d] = dims;
      const hw = w/2, hh = h/2, hd = d/2;

      // 6 faces of a box
      return [
        [[cx-hw,cy-hh,cz+hd],[cx+hw,cy-hh,cz+hd],[cx+hw,cy+hh,cz+hd],[cx-hw,cy+hh,cz+hd]], // front
        [[cx+hw,cy-hh,cz-hd],[cx-hw,cy-hh,cz-hd],[cx-hw,cy+hh,cz-hd],[cx+hw,cy+hh,cz-hd]], // back
        [[cx-hw,cy-hh,cz-hd],[cx+hw,cy-hh,cz-hd],[cx+hw,cy-hh,cz+hd],[cx-hw,cy-hh,cz+hd]], // top
        [[cx-hw,cy+hh,cz+hd],[cx+hw,cy+hh,cz+hd],[cx+hw,cy+hh,cz-hd],[cx-hw,cy+hh,cz-hd]], // bottom
        [[cx+hw,cy-hh,cz+hd],[cx+hw,cy-hh,cz-hd],[cx+hw,cy+hh,cz-hd],[cx+hw,cy+hh,cz+hd]], // right
        [[cx-hw,cy-hh,cz-hd],[cx-hw,cy-hh,cz+hd],[cx-hw,cy+hh,cz+hd],[cx-hw,cy+hh,cz-hd]], // left
      ].map(f => f.map(([x,y,z]) => ({x,y,z})));
    }

    getFaceBrightness(face) {
      const v1 = { x: face[1].x-face[0].x, y: face[1].y-face[0].y, z: face[1].z-face[0].z };
      const v2 = { x: face[2].x-face[0].x, y: face[2].y-face[0].y, z: face[2].z-face[0].z };
      const n = {
        x: v1.y*v2.z - v1.z*v2.y,
        y: v1.z*v2.x - v1.x*v2.z,
        z: v1.x*v2.y - v1.y*v2.x
      };
      const len = Math.sqrt(n.x*n.x + n.y*n.y + n.z*n.z) || 1;
      n.x /= len; n.y /= len; n.z /= len;
      const light = { x: -0.5, y: -0.7, z: 0.5 };
      const llen = Math.sqrt(light.x*light.x + light.y*light.y + light.z*light.z);
      light.x /= llen; light.y /= llen; light.z /= llen;
      const dot = n.x*light.x + n.y*light.y + n.z*light.z;
      return Math.max(0.15, (dot + 1) / 2);
    }

    isFrontFacing(face) {
      const v1 = { x: face[1].x-face[0].x, y: face[1].y-face[0].y };
      const v2 = { x: face[2].x-face[0].x, y: face[2].y-face[0].y };
      return (v1.x*v2.y - v1.y*v2.x) > 0;
    }

    render() {
      const ctx = this.ctx;
      const w = this.canvas.width;
      const h = this.canvas.height;

      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, w, h);

      // Penrose triangle from STL analysis:
      // Bar thickness = 20, Bar length = 98
      // Normalized and centered
      const T = 20;  // thickness
      const L = 98;  // length

      // Center offset to put origin at center of bounding box
      // Original: x=-59 to 39, y=-59 to 59, z=0 to 118
      // Center: x=-10, y=0, z=59
      const ox = -10, oy = 0, oz = 59;

      // Bar 1: Horizontal (X-axis) - bottom bar going left
      // x: -59 to 39, y: -59 to -39, z: 0 to 20
      const bar1 = this.createBar(-10 - ox, -49 - oy, 10 - oz, 'x', L, T);

      // Bar 2: Vertical (Y-axis) - right side going up
      // x: 19 to 39, y: -39 to 59, z: 0 to 20
      const bar2 = this.createBar(29 - ox, 10 - oy, 10 - oz, 'y', L, T);

      // Bar 3: Depth (Z-axis) - top right going back
      // x: 19 to 39, y: 39 to 59, z: 20 to 118
      const bar3 = this.createBar(29 - ox, 49 - oy, 69 - oz, 'z', L, T);

      const allFaces = [];
      // Normal 3D z-ordering: faces closer to camera draw last (on top)
      [bar1, bar2, bar3].forEach((bar, barIdx) => {
        bar.forEach(face => {
          const rotated = face.map(p => this.project(p));
          if (this.isFrontFacing(rotated)) {
            const z = rotated.reduce((s,p) => s+p.z, 0) / 4;
            allFaces.push({
              verts: rotated,
              brightness: this.getFaceBrightness(rotated),
              z: z,
              bar: barIdx
            });
          }
        });
      });

      allFaces.sort((a,b) => b.z - a.z); // Higher z (further) draws first, closer draws last

      const scale = 2.2;
      const cx = w/2, cy = h/2;

      allFaces.forEach(f => {
        ctx.beginPath();
        f.verts.forEach((v,i) => {
          const sx = cx + v.x * scale;
          const sy = cy + v.y * scale;
          i === 0 ? ctx.moveTo(sx,sy) : ctx.lineTo(sx,sy);
        });
        ctx.closePath();
        const gray = Math.round(f.brightness * 255);
        ctx.fillStyle = `rgb(${f.bar * 80 + 40}, ${gray}, ${gray})`;
        ctx.fill();
      });

      this.toASCII();
    }

    toASCII() {
      const img = this.ctx.getImageData(0, 0, this.canvas.width, this.canvas.height);
      const RAMP = ' .:-=+*#%@';

      this.pre.textContent = '';
      const frag = document.createDocumentFragment();

      for (let row = 0; row < this.rows; row++) {
        for (let col = 0; col < this.cols; col++) {
          const x = Math.floor((col + 0.5) * this.cellWidth);
          const y = Math.floor((row + 0.5) * this.cellHeight);
          const i = (y * this.canvas.width + x) * 4;
          const r = img.data[i], g = img.data[i+1];
          const bar = Math.round((r - 40) / 80);
          const brightness = g / 255;

          if (brightness < 0.05) {
            frag.appendChild(document.createTextNode(' '));
          } else {
            const char = RAMP[Math.min(Math.floor(brightness * RAMP.length), RAMP.length-1)];
            const span = document.createElement('span');
            span.className = 'c' + Math.min(bar, 2);
            span.textContent = char;
            frag.appendChild(span);
          }
        }
        frag.appendChild(document.createTextNode('\n'));
      }
      this.pre.appendChild(frag);
    }
  }

  document.querySelectorAll('.penrose-bg').forEach(el => new PenroseRenderer(el));
</script>
