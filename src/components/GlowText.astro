---
export interface Props {
  color?: string;  // Any CSS color value
  intensity?: "low" | "medium" | "high";
}

const {
  color = 'var(--color-accent)',
  intensity = "medium"
} = Astro.props;

// Simple intensity mapping - 3 levels is plenty
const glowSize = {
  low: '8px',
  medium: '15px',
  high: '24px'
}[intensity];

const glowOpacity = {
  low: '0.4',
  medium: '0.6',
  high: '0.8'
}[intensity];
---

<span
  class="glow-text"
  style={`
    color: ${color};
    --glow-color: ${color};
    --glow-size: ${glowSize};
    --glow-opacity: ${glowOpacity};
  `}
>
  <slot />
</span>

<style>
  .glow-text {
    transition: text-shadow var(--transition-fast, 0.15s ease-out);
  }

  .glow-text:hover {
    text-shadow: 0 0 var(--glow-size) color-mix(in srgb, var(--glow-color) calc(var(--glow-opacity) * 100%), transparent);
  }
</style>
