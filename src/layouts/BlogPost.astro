---
export interface Props {
  title: string;
  description: string;
  pubDate: string | Date;
  author: string;
  image?: {
    url: string;
    alt: string;
  };
  tags?: string[];
}

// Access frontmatter data from Astro.props.frontmatter for markdown files
const frontmatter = Astro.props.frontmatter || Astro.props;
const { title, description, pubDate, author, image, tags } = frontmatter;

const dateObj = pubDate ? new Date(pubDate) : new Date();
const formattedDate = dateObj.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

// Post navigation data
const allPosts = [
  { title: "Bringing SQLGlot to Metabase: Swappable SQL Parsing via GraalVM", url: "/posts/post-5/" },
  { title: "Goto in Clojure: Why I Built It and Why It's Fun", url: "/posts/post-1/" },
  { title: "Introducing go-silo: Markdown for File Structures & Contents", url: "/posts/post-2/" },
  { title: "Mage at Metabase: A Unified Task Runner Built for a Growing Engineering Org", url: "/posts/post-3/" },
  { title: "Glick80: When Functional Purity Meets Retro Gaming", url: "/posts/post-4/" },
  { title: "Crossums: A Number Puzzle Roguelike", url: "/posts/post-6/" },
  { title: "10 Custom Subagents for Taming a Giant Codebase", url: "/posts/post-7/" },
  { title: "Explicit, Typed, and Predictable: Architecture for Humans and Agents", url: "/posts/post-8/" }
];

const currentUrl = Astro.url.pathname;
const currentIndex = allPosts.findIndex(post => post.url === currentUrl);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<html lang="en">
<head>
  <!-- Prevent flash of wrong theme -->
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.setAttribute('data-theme', stored);
      }
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content={author} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={`https://escherize.com${Astro.url.pathname}`} />
  <meta property="article:author" content={author} />
  <meta property="article:published_time" content={dateObj.toISOString()} />
  {tags && tags.length > 0 && (
    <>
      {tags.map(tag => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )}
  {image && (
    <>
      <meta property="og:image" content={image.url} />
      <meta property="og:image:alt" content={image.alt} />
    </>
  )}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@escherize" />
  <title>{title}</title>

  <!-- Fonts: Space Grotesk (display) + Source Sans 3 (body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.gstatic.com/s/spacegrotesk/v16/V8mDoQDjQSkFtoMM3T6r8E7mPbF4Cw.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="https://fonts.gstatic.com/s/sourcesans3/v15/nwpBtKy2OAdR1K-IwhWudF-R9QMylBJAV3Bo8Ky46lEN_io6npfB.woff2" as="font" type="font/woff2" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  </noscript>

  <style is:global>
    /* ============================================
       DESIGN TOKENS - Playful Chaos Edition
       Matches BaseLayout.astro for consistency
       Note: is:global so .post-content child rules
       (h1, p, img, etc.) reach markdown-rendered tags
       which don't carry Astro's scope attribute.
       ============================================ */
    :root {
      /* Colors - Warm cream background with ink-like text */
      --color-bg: #faf8f5;
      --color-bg-alt: #f0ece4;
      --color-bg-elevated: #ffffff;
      --color-fg: #1a1a1a;
      --color-fg-muted: #4a4a4a;
      --color-fg-subtle: #6b6b6b;

      /* Colors - Energetic accent palette */
      --color-accent: #e85d04;
      --color-accent-hover: #d00000;
      --color-accent-soft: rgba(232, 93, 4, 0.1);
      --color-pop: #8338ec;
      --color-pop-soft: rgba(131, 56, 236, 0.1);

      /* Colors - Border */
      --color-border: #e0dcd4;
      --color-border-subtle: rgba(0, 0, 0, 0.06);
      --color-border-hover: rgba(0, 0, 0, 0.15);

      /* Typography - Distinctive pairing */
      --font-display: 'Space Grotesk', system-ui, sans-serif;
      --font-body: 'Source Sans 3', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', 'SF Mono', monospace;

      --font-size-xs: 0.75rem;
      --font-size-sm: 0.875rem;
      --font-size-base: 1.0625rem;
      --font-size-lg: 1.25rem;
      --font-size-xl: 1.5rem;
      --font-size-2xl: 2rem;
      --font-size-3xl: clamp(2.5rem, 5vw, 3.5rem);

      --font-weight-normal: 400;
      --font-weight-medium: 500;
      --font-weight-semibold: 600;
      --font-weight-bold: 700;

      --line-height-tight: 1.1;
      --line-height-normal: 1.6;
      --line-height-relaxed: 1.75;

      /* Spacing */
      --space-1: 0.25rem;
      --space-2: 0.5rem;
      --space-3: 0.75rem;
      --space-4: 1rem;
      --space-5: 1.25rem;
      --space-6: 1.5rem;
      --space-8: 2rem;
      --space-10: 2.5rem;
      --space-12: 3rem;
      --space-16: 4rem;

      /* Border radius */
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 12px;
      --radius-xl: 16px;
      --radius-full: 999px;

      /* Shadows - warm tinted */
      --shadow-sm: 0 2px 8px rgba(26, 26, 26, 0.06);
      --shadow-md: 0 4px 20px rgba(26, 26, 26, 0.08);
      --shadow-lg: 0 8px 40px rgba(26, 26, 26, 0.1);

      /* Offset shadows - playful brutalist style */
      --shadow-offset-sm: 4px 4px 0 var(--color-fg);
      --shadow-offset-md: 6px 6px 0 var(--color-fg);
      --shadow-offset-lg: 8px 8px 0 var(--color-fg);
      --shadow-playful: var(--shadow-offset-sm);

      /* Border widths */
      --border-thin: 1px;
      --border-medium: 2px;
      --border-thick: 3px;

      /* Transitions */
      --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
      --transition-fast: 0.15s var(--ease-out-expo);
      --transition-normal: 0.25s var(--ease-out-expo);

      /* Code blocks */
      --code-bg: #1c1917;
      --code-fg: #fafaf9;
      --code-border: var(--color-border);

      /* Theme state */
      color-scheme: light dark;
    }

    /* ============================================
       DARK MODE - Warm & Cozy
       ============================================ */
    @media (prefers-color-scheme: dark) {
      :root {
        --color-bg: #1c1917;
        --color-bg-alt: #292524;
        --color-bg-elevated: #292524;
        --color-fg: #fafaf9;
        --color-fg-muted: #a8a29e;
        --color-fg-subtle: #78716c;
        --color-accent: #fb923c;
        --color-accent-hover: #f97316;
        --color-accent-soft: rgba(251, 146, 60, 0.15);
        --color-pop: #a78bfa;
        --color-pop-soft: rgba(167, 139, 250, 0.15);
        --color-border: #44403c;
        --color-border-subtle: rgba(255, 255, 255, 0.06);
        --color-border-hover: rgba(255, 255, 255, 0.15);
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
        --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.4);
        --shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.5);
        --shadow-offset-sm: 4px 4px 0 #44403c;
        --shadow-offset-md: 6px 6px 0 #44403c;
        --shadow-offset-lg: 8px 8px 0 #44403c;
        --shadow-playful: var(--shadow-offset-sm);
        --code-bg: #0c0a09;
        --code-border: #44403c;
      }

      ::selection {
        background: var(--color-accent);
        color: #1c1917;
      }
    }

    /* Manual theme override */
    [data-theme="dark"] {
      --color-bg: #1c1917;
      --color-bg-alt: #292524;
      --color-bg-elevated: #292524;
      --color-fg: #fafaf9;
      --color-fg-muted: #a8a29e;
      --color-fg-subtle: #78716c;
      --color-accent: #fb923c;
      --color-accent-hover: #f97316;
      --color-accent-soft: rgba(251, 146, 60, 0.15);
      --color-pop: #a78bfa;
      --color-pop-soft: rgba(167, 139, 250, 0.15);
      --color-border: #44403c;
      --color-border-subtle: rgba(255, 255, 255, 0.06);
      --color-border-hover: rgba(255, 255, 255, 0.15);
      --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
      --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.4);
      --shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.5);
      --shadow-offset-sm: 4px 4px 0 #44403c;
      --shadow-offset-md: 6px 6px 0 #44403c;
      --shadow-offset-lg: 8px 8px 0 #44403c;
      --shadow-playful: var(--shadow-offset-sm);
      --code-bg: #0c0a09;
      --code-border: #44403c;
    }

    [data-theme="light"] {
      --color-bg: #faf8f5;
      --color-bg-alt: #f0ece4;
      --color-bg-elevated: #ffffff;
      --color-fg: #1a1a1a;
      --color-fg-muted: #4a4a4a;
      --color-fg-subtle: #6b6b6b;
      --color-accent: #e85d04;
      --color-accent-hover: #d00000;
      --color-accent-soft: rgba(232, 93, 4, 0.1);
      --color-pop: #8338ec;
      --color-pop-soft: rgba(131, 56, 236, 0.1);
      --color-border: #e0dcd4;
      --color-border-subtle: rgba(0, 0, 0, 0.06);
      --color-border-hover: rgba(0, 0, 0, 0.15);
      --shadow-sm: 0 2px 8px rgba(26, 26, 26, 0.06);
      --shadow-md: 0 4px 20px rgba(26, 26, 26, 0.08);
      --shadow-lg: 0 8px 40px rgba(26, 26, 26, 0.1);
      --shadow-offset-sm: 4px 4px 0 var(--color-fg);
      --shadow-offset-md: 6px 6px 0 var(--color-fg);
      --shadow-offset-lg: 8px 8px 0 var(--color-fg);
      --shadow-playful: var(--shadow-offset-sm);
      --code-bg: #1c1917;
      --code-border: var(--color-border);
    }

    /* ============================================
       BASE STYLES
       ============================================ */
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: var(--font-body);
      font-size: var(--font-size-base);
      background: var(--color-bg);
      color: var(--color-fg);
      line-height: var(--line-height-relaxed);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      min-height: 100vh;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-display);
      font-weight: var(--font-weight-bold);
      line-height: var(--line-height-tight);
      letter-spacing: -0.02em;
    }

    ::selection {
      background: var(--color-accent);
      color: white;
    }

    /* Skip link - only visible on focus for keyboard users */
    .skip-link {
      position: fixed;
      top: -100%;
      left: var(--space-4);
      z-index: 200;
      padding: var(--space-3) var(--space-5);
      background: var(--color-fg);
      color: var(--color-bg);
      font-family: var(--font-display);
      font-weight: var(--font-weight-bold);
      font-size: var(--font-size-sm);
      text-decoration: none;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-playful);
      transition: top var(--transition-fast);
    }

    .skip-link:focus {
      top: var(--space-4);
      outline: 3px solid var(--color-accent);
      outline-offset: 2px;
    }

    /* Focus styles */
    :focus-visible {
      outline: 3px solid var(--color-accent);
      outline-offset: 3px;
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* ============================================
       LAYOUT
       ============================================ */
    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: var(--space-6) var(--space-5);
    }

    .nav {
      margin-bottom: var(--space-8);
      animation: slideDown 0.5s var(--ease-out-expo) backwards;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
    }

    .nav a {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-fg);
      text-decoration: none;
      font-family: var(--font-display);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-md);
      border: 2px solid var(--color-fg);
      background: var(--color-bg);
      transition: all var(--transition-fast);
    }

    .nav a:hover {
      background: var(--color-fg);
      color: var(--color-bg);
      transform: translateX(-4px);
    }

    /* ============================================
       POST HEADER - HERO TREATMENT
       ============================================ */
    .post-header {
      position: relative;
      margin-bottom: var(--space-12);
      padding: var(--space-12) var(--space-8);
      background: var(--color-bg-elevated);
      border: 3px solid var(--color-fg);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-offset-lg);
      overflow: hidden;
      animation: heroSlide 0.6s var(--ease-out-expo) 0.1s backwards;
    }

    @keyframes heroSlide {
      from {
        opacity: 0;
        transform: translateY(30px) rotate(-1deg);
      }
    }

    /* Decorative corner accent */
    .post-header::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 120px;
      height: 120px;
      background: var(--color-accent);
      opacity: 0.15;
      border-radius: 0 0 0 100%;
      pointer-events: none;
    }

    /* Decorative dot pattern */
    .post-header::after {
      content: '• • •';
      position: absolute;
      bottom: var(--space-4);
      right: var(--space-6);
      font-size: var(--font-size-2xl);
      color: var(--color-pop);
      opacity: 0.4;
      letter-spacing: 8px;
      pointer-events: none;
    }

    .post-title {
      margin: 0 0 var(--space-6);
      font-size: clamp(2rem, 6vw, 3.5rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
      color: var(--color-fg);
      font-weight: var(--font-weight-bold);
      max-width: 90%;
    }

    /* First word accent */
    .post-title-accent {
      color: var(--color-accent);
      font-style: italic;
    }

    @media (max-width: 640px) {
      .post-header {
        padding: var(--space-8) var(--space-5);
        box-shadow: var(--shadow-offset-md);
      }

      .post-title {
        font-size: clamp(1.75rem, 8vw, 2.5rem);
        max-width: 100%;
      }
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: var(--space-6);
      font-family: var(--font-display);
      font-size: var(--font-size-sm);
      color: var(--color-fg-muted);
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-1) var(--space-3);
      background: var(--color-bg-alt);
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
    }

    .meta-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-accent);
    }

    .post-description {
      font-size: var(--font-size-xl);
      color: var(--color-fg);
      line-height: var(--line-height-normal);
      margin-bottom: var(--space-6);
      max-width: 600px;
      font-weight: var(--font-weight-normal);
    }

    .post-description code {
      font-family: var(--font-mono);
      font-size: 0.9em;
      background: var(--color-accent-soft);
      color: var(--color-accent);
      padding: 0.1em 0.3em;
      border-radius: var(--radius-sm);
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .tag {
      font-family: var(--font-display);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-medium);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-sm);
      border: none;
      color: white;
      background: var(--color-accent);
      transition: transform var(--transition-fast);
    }

    .tag:nth-child(2n) {
      background: var(--color-pop);
    }

    .tag:nth-child(3n) {
      background: var(--color-fg);
    }

    .tag:hover {
      transform: translateY(-2px) rotate(-2deg);
    }

    /* ============================================
       POST CONTENT - Bold & Readable
       ============================================ */
    .post-content {
      background: var(--color-bg-elevated);
      border-radius: var(--radius-lg);
      padding: var(--space-12) var(--space-10);
      border: 2px solid var(--color-border);
      box-shadow: var(--shadow-lg);
      /* CSS Containment for better rendering performance */
      contain: layout style;
      animation: contentFade 0.5s var(--ease-out-expo) 0.3s backwards;
    }

    @keyframes contentFade {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }

    @media (max-width: 640px) {
      .post-content {
        padding: var(--space-6) var(--space-5);
      }
    }

    /* Typography - Bold & Distinctive */
    .post-content h1 {
      margin: var(--space-16) 0 var(--space-8);
      font-size: clamp(2rem, 5vw, 2.75rem);
      font-weight: var(--font-weight-bold);
      letter-spacing: -0.03em;
      color: var(--color-fg);
      padding-bottom: var(--space-4);
      border-bottom: 3px solid var(--color-accent);
      position: relative;
    }

    .post-content h1::after {
      content: '';
      position: absolute;
      bottom: -3px;
      left: 0;
      width: 60px;
      height: 3px;
      background: var(--color-pop);
    }

    .post-content h1:first-child {
      margin-top: 0;
    }

    .post-content h2 {
      margin: var(--space-12) 0 var(--space-5);
      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-bold);
      color: var(--color-fg);
      letter-spacing: -0.02em;
      position: relative;
      padding-left: var(--space-5);
    }

    .post-content h2::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: var(--color-accent);
      border-radius: 2px;
    }

    .post-content h3 {
      margin: var(--space-8) 0 var(--space-4);
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-bold);
      color: var(--color-fg);
    }

    .post-content p {
      margin: var(--space-5) 0;
      color: var(--color-fg);
      font-size: var(--font-size-base);
      line-height: var(--line-height-relaxed);
    }

    .post-content a {
      color: var(--color-accent);
      text-decoration: none;
      font-weight: var(--font-weight-medium);
      border-bottom: 2px solid var(--color-accent-soft);
      transition: all var(--transition-fast);
    }

    .post-content a:hover {
      color: var(--color-accent-hover);
      border-bottom-color: var(--color-accent-hover);
      background: var(--color-accent-soft);
    }

    .post-content strong {
      color: var(--color-fg);
      font-weight: var(--font-weight-bold);
    }

    .post-content em {
      font-style: italic;
      color: var(--color-fg);
    }

    .post-content ul,
    .post-content ol {
      margin: var(--space-6) 0;
      padding-left: var(--space-8);
      color: var(--color-fg);
    }

    .post-content li {
      margin: var(--space-3) 0;
      position: relative;
    }

    .post-content ul li::marker {
      color: var(--color-accent);
      font-size: 1.2em;
    }

    .post-content ol li::marker {
      color: var(--color-pop);
      font-weight: var(--font-weight-bold);
    }

    /* Blockquotes - Standout callouts */
    .post-content blockquote {
      margin: var(--space-8) 0;
      padding: var(--space-6) var(--space-8);
      border-left: 5px solid var(--color-accent);
      background: var(--color-accent-soft);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      font-style: italic;
      color: var(--color-fg);
      position: relative;
    }

    .post-content blockquote::before {
      content: '"';
      position: absolute;
      top: var(--space-2);
      left: var(--space-3);
      font-size: 3rem;
      font-family: var(--font-display);
      color: var(--color-accent);
      opacity: 0.3;
      line-height: 1;
    }

    .post-content blockquote p {
      margin: var(--space-2) 0;
      font-size: var(--font-size-lg);
    }

    /* Inline code - Vibrant */
    .post-content code {
      font-family: var(--font-mono);
      font-size: 0.88em;
      padding: 0.15em 0.4em;
      background: var(--color-accent-soft);
      border: none;
      border-radius: var(--radius-sm);
      color: var(--color-accent);
      font-weight: var(--font-weight-medium);
    }

    /* Code blocks - Bold & Dark */
    .post-content pre {
      margin: var(--space-8) 0;
      padding: var(--space-6);
      background: var(--code-bg);
      border: 3px solid var(--color-border);
      border-radius: var(--radius-lg);
      overflow-x: auto;
      position: relative;
      box-shadow: var(--shadow-offset-md);
    }

    .post-content pre::before {
      content: 'CODE';
      position: absolute;
      top: 0;
      right: var(--space-4);
      transform: translateY(-50%);
      font-family: var(--font-display);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      background: var(--color-accent);
      color: white;
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-sm);
    }

    .post-content pre code {
      font-size: var(--font-size-sm);
      padding: 0;
      background: transparent;
      border: none;
      color: var(--code-fg);
      line-height: 1.7;
      font-weight: var(--font-weight-normal);
    }

    /* Horizontal rules - Decorative */
    .post-content hr {
      margin: var(--space-12) 0;
      border: none;
      height: 3px;
      background: linear-gradient(90deg, var(--color-accent) 0%, var(--color-pop) 50%, var(--color-accent) 100%);
      border-radius: var(--radius-full);
      opacity: 0.6;
    }

    /* Tables - Clean & Bold */
    .post-content table {
      width: 100%;
      margin: var(--space-8) 0;
      border-collapse: collapse;
      border: 2px solid var(--color-fg);
      border-radius: var(--radius-md);
      overflow: hidden;
    }

    .post-content th {
      background: var(--color-fg);
      color: var(--color-bg);
      padding: var(--space-4);
      text-align: left;
      font-family: var(--font-display);
      font-weight: var(--font-weight-bold);
      font-size: var(--font-size-sm);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .post-content td {
      padding: var(--space-4);
      border-bottom: 1px solid var(--color-border);
    }

    .post-content tr:last-child td {
      border-bottom: none;
    }

    .post-content tr:nth-child(even) {
      background: var(--color-bg-alt);
    }

    /* Images - Dramatic frames, constrained to readable size */
    .post-content img {
      display: block;
      width: 100%;
      max-width: 480px;
      height: auto;
      max-height: 70vh;
      object-fit: contain;
      margin: var(--space-8) auto;
      padding: var(--space-3);
      background: var(--color-bg-alt);
      border: 3px solid var(--color-fg);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-offset-md);
      box-sizing: border-box;
    }

    /* ============================================
       POST NAVIGATION - Bold & Playful
       ============================================ */
    .post-navigation {
      margin-top: var(--space-16);
      animation: navSlide 0.5s var(--ease-out-expo) 0.5s backwards;
    }

    @keyframes navSlide {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
    }

    .nav-header {
      font-family: var(--font-display);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-fg-muted);
      margin-bottom: var(--space-4);
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .nav-header::after {
      content: '';
      flex: 1;
      height: 2px;
      background: var(--color-border);
    }

    .post-nav-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }

    @media (max-width: 640px) {
      .post-nav-grid {
        grid-template-columns: 1fr;
        gap: var(--space-3);
      }
    }

    .post-nav-item {
      display: block;
      text-decoration: none;
      padding: var(--space-5) var(--space-6);
      border-radius: var(--radius-md);
      border: 2px solid var(--color-fg);
      background: var(--color-bg-elevated);
      transition: all var(--transition-fast);
      position: relative;
      overflow: hidden;
    }

    .post-nav-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-accent);
      transform: translateX(-100%);
      transition: transform var(--transition-normal);
      z-index: 0;
    }

    .post-nav-item:hover::before {
      transform: translateX(0);
    }

    .post-nav-item:hover {
      color: white;
      border-color: var(--color-accent);
      box-shadow: var(--shadow-offset-sm);
      transform: translate(-2px, -2px);
    }

    .post-nav-item.prev {
      text-align: left;
    }

    .post-nav-item.next {
      text-align: right;
    }

    .post-nav-item.next::before {
      transform: translateX(100%);
    }

    .post-nav-item.next:hover::before {
      transform: translateX(0);
    }

    .post-nav-item.only {
      grid-column: 1 / -1;
      text-align: center;
    }

    .post-nav-label {
      font-family: var(--font-display);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      color: var(--color-fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: var(--space-2);
      display: block;
      position: relative;
      z-index: 1;
      transition: color var(--transition-fast);
    }

    .post-nav-title {
      font-family: var(--font-display);
      font-size: var(--font-size-base);
      color: var(--color-fg);
      font-weight: var(--font-weight-bold);
      line-height: var(--line-height-tight);
      position: relative;
      z-index: 1;
      transition: color var(--transition-fast);
    }

    .post-nav-item:hover .post-nav-label,
    .post-nav-item:hover .post-nav-title {
      color: white;
    }

    /* ============================================
       FOOTER - Bold & Centered
       ============================================ */
    .footer {
      margin-top: var(--space-12);
      padding: var(--space-8);
      text-align: center;
      border-top: 3px solid var(--color-fg);
      animation: footerFade 0.4s var(--ease-out-expo) 0.6s backwards;
    }

    @keyframes footerFade {
      from {
        opacity: 0;
      }
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: var(--space-6);
      flex-wrap: wrap;
    }

    .footer a {
      font-family: var(--font-display);
      font-weight: var(--font-weight-medium);
      color: var(--color-fg);
      text-decoration: none;
      font-size: var(--font-size-sm);
      padding: var(--space-2) var(--space-4);
      border: 2px solid transparent;
      border-radius: var(--radius-md);
      transition: all var(--transition-fast);
    }

    .footer a:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      transform: translateY(-2px);
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <div class="container">
    <nav class="nav">
      <a href="/">← Back to Home</a>
    </nav>

    <article id="main-content">
      <header class="post-header">
        <div class="post-meta">
          <span class="meta-item">
            <span class="meta-dot" aria-hidden="true"></span>
            {author}
          </span>
          <span class="meta-item">
            <span class="meta-dot" aria-hidden="true"></span>
            <time datetime={dateObj.toISOString()}>{formattedDate}</time>
          </span>
        </div>
        <h1 class="post-title">{title}</h1>
        {description && <p class="post-description" set:html={description.replace(/`([^`]+)`/g, '<code>$1</code>')} />}
        {tags && tags.length > 0 && (
          <div class="tags">
            {tags.map((tag, i) => <span class="tag" style={`animation-delay: ${i * 50}ms`}>{tag}</span>)}
          </div>
        )}
      </header>

      <div class="post-content">
        <slot />
      </div>
    </article>

    {(prevPost || nextPost) && (
      <nav class="post-navigation" aria-label="Post navigation">
        <div class="nav-header">Keep Reading</div>
        <div class="post-nav-grid">
          {prevPost && (
            <a href={prevPost.url} class="post-nav-item prev">
              <span class="post-nav-label">← Previous</span>
              <span class="post-nav-title">{prevPost.title}</span>
            </a>
          )}
          {!prevPost && nextPost && (
            <div></div>
          )}
          {nextPost && (
            <a href={nextPost.url} class={`post-nav-item ${!prevPost ? 'only next' : 'next'}`}>
              <span class="post-nav-label">Next →</span>
              <span class="post-nav-title">{nextPost.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}

    <footer class="footer">
      <div class="footer-links">
        <a href="/blog/">← All Posts</a>
        <a href="/">Return to Home</a>
      </div>
    </footer>
  </div>

  <!-- Apply lazy loading to images in content -->
  <script>
    document.querySelectorAll('.post-content img').forEach(img => {
      img.setAttribute('loading', 'lazy');
      img.setAttribute('decoding', 'async');
    });
  </script>
</body>
</html>
